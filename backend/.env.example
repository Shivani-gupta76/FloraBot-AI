DATABASE_URL=
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional: path to the trained YOLO11n-cls weights, e.g. models/flora_bot_best.pt
FLORABOT_MODEL_PATH=
# Camera upload must remain disabled until a unique device token and an existing plant ID are configured.
# Generate a long random token; never commit the real value or print it in logs.
# FLORABOT_CAMERA_DEVICE_TOKEN=<replace-with-a-random-device-token>
# Bind this camera credential to one existing plant record.
# FLORABOT_CAMERA_PLANT_ID=1
# Device status considers a recent heartbeat online for this many seconds.
FLORABOT_DEVICE_HEARTBEAT_TIMEOUT_SECONDS=180
# LED command delivery lease and maximum lifetime/retries.
FLORABOT_DEVICE_COMMAND_LEASE_SECONDS=30
FLORABOT_DEVICE_COMMAND_MAX_ATTEMPTS=3
FLORABOT_DEVICE_COMMAND_TTL_SECONDS=300
