# Copy to .env and fill in. Never commit .env.

# ESP32 adapter: "dummy" runs a simulated ESP32 inside the backend (open /esp32.html to control it);
# "real" waits for the physical board to poll the device endpoints.
FLORABOT_DEVICE_MODE=dummy
FLORABOT_DEVICE_ID=esp32-led1
# Real mode only: shared secret the ESP32 sends as "Authorization: Bearer <token>" (16+ characters).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FLORABOT_DEVICE_TOKEN=

FLORABOT_DATABASE_URL=sqlite:///./florabot.db

# AI adapter: "mock" or "gemini". It analyses photos and answers plant-care questions.
FLORABOT_VISION_PROVIDER=mock
# What the mock returns: WATERING_RECOMMENDED, WATERING_NOT_RECOMMENDED or UNCERTAIN.
FLORABOT_MOCK_RECOMMENDATION=WATERING_RECOMMENDED
# Pretend thinking time for the mock, so the chat's progress steps are visible.
FLORABOT_MOCK_DELAY_SECONDS=1.5

# Gemini free tier: create a key at https://aistudio.google.com/apikey
FLORABOT_GEMINI_API_KEY=
# "gemini-flash-lite-latest" follows Google's newest Flash-Lite model and answers in a few seconds.
# The bigger "gemini-flash-latest" took 44-90 s per request in testing, which is too slow here.
FLORABOT_GEMINI_MODEL=gemini-flash-lite-latest
# Seconds per Gemini request for watering and plant-care answers.
FLORABOT_GEMINI_TIMEOUT_SECONDS=30
# Model for the detailed plant-health review, which gets the leaf model's result as context.
# In testing, gemini-flash-lite-latest answered in about 3 s; gemini-flash-latest took 77 s or timed out;
# Pro models had no free-tier quota. A slower model only delays the review, never the watering result or LED.
FLORABOT_GEMINI_REVIEW_MODEL=gemini-flash-lite-latest
FLORABOT_GEMINI_REVIEW_TIMEOUT_SECONDS=90

# Leaf-disease model used by the plant-health check (never decides watering): "yolo" or "mock".
FLORABOT_DISEASE_CLASSIFIER=yolo

# How long an LED command waits for the ESP32 before it is reported as unconfirmed.
FLORABOT_COMMAND_TTL_SECONDS=30
# The ESP32 counts as offline if it has not polled for this long.
FLORABOT_DEVICE_OFFLINE_SECONDS=15
# Photo analyses and plant-care questions allowed per minute from each browser.
FLORABOT_RATE_LIMIT_PER_MINUTE=10
